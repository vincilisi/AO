# API e dashboard
API_HOST=127.0.0.1
API_PORT=4000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
APP_URL=http://localhost:3000

# PayPal: usare un'app Sandbox in sviluppo e non committare mai i valori reali
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=sostituire-con-client-id-sandbox
PAYPAL_CLIENT_SECRET=sostituire-con-client-secret-sandbox
PAYPAL_WEBHOOK_ID=sostituire-con-webhook-id-sandbox

# PostgreSQL
DATABASE_URL=postgresql://office:office@localhost:5432/ai_office_manager
INTERNAL_API_KEY=sostituire-con-una-chiave-casuale
MAILBOX_ENCRYPTION_KEY=sostituire-con-una-chiave-casuale-diversa

# Gmail: usare una password per app, non la password principale
EMAIL_USER=nome@gmail.com
EMAIL_PASS=password-per-app
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465